# Copy to .env and fill in real values. Never commit the filled-in .env.

# --- PostgreSQL -----------------------------------------------------------
POSTGRES_USER=nowdone
POSTGRES_PASSWORD=change-me
POSTGRES_DB=nowdone

# Full DSN used by the Go backend (pgx). Host "postgres" matches the Compose
# service name; keep in sync with the POSTGRES_* values above.
DB_DSN=postgres://nowdone:change-me@postgres:5432/nowdone?sslmode=disable

# --- Auth ---------------------------------------------------------------
# Long random string used to sign JWTs. Generate with: openssl rand -hex 32
JWT_SECRET=change-me-64-hex-chars

# --- Telegram -------------------------------------------------------------
# Token from @BotFather.
TELEGRAM_BOT_TOKEN=000000000:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Bot username WITHOUT the @, used to build https://t.me/<BOT_USERNAME>?start=... links.
BOT_USERNAME=your_bot
# Optional. Reverse-proxy origin for the Telegram Bot API (e.g. a Cloudflare
# Worker) to bypass network blocks. Leave empty to use https://api.telegram.org.
# The proxy must forward both /bot<token>/<method> and /file/bot<token>/<path>.
TELEGRAM_API_PROXY_URL=

# --- OpenAI -----------------------------------------------------------------
# Used by the bot for gpt-4o-mini intent parsing and Whisper voice transcription.
OPENAI_API_KEY=sk-...

# --- S3-compatible object storage (attachments) ------------------------------
# The Go client uses path-style addressing, so S3_ENDPOINT must be the bare
# service root (no bucket, no "s3." prefix). The SDK builds
# "{S3_ENDPOINT}/{S3_BUCKET_NAME}/{key}" itself.
S3_ACCESS_KEY_ID=change-me
S3_SECRET_ACCESS_KEY=change-me
S3_BUCKET_NAME=your-bucket
S3_ENDPOINT=https://s3.example.com
S3_REGION=us-east-1
# Optional. Base URL used to build public links returned to the frontend.
# Empty => "{S3_ENDPOINT}/{S3_BUCKET_NAME}/{key}" (path-style).
S3_PUBLIC_BASE_URL=
# Lifetime (minutes) of presigned upload URLs handed to the browser for direct
# S3 uploads. Short by design; default 15 if unset.
S3_PRESIGN_EXPIRY=15

# --- Site -------------------------------------------------------------------
# Public URL of the deployed frontend, used for CORS and building bot deep links.
SITE_URL=https://example.com
# Set to the frontend's origin to scope the session cookie; leave empty for host-only.
COOKIE_DOMAIN=

# Base URL the frontend uses to reach the API (reverse-proxied path or full origin).
VITE_API_BASE_URL=/api

ENV=production
