OPENAI_API_KEY=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

# --- S3-compatible object storage (attachments) ------------------------------
# Provider: firsts3.ru. The Go client uses path-style addressing, so S3_ENDPOINT
# must be the bare service root (no bucket, no "s3." prefix). The SDK builds
# "{S3_ENDPOINT}/{S3_BUCKET_NAME}/{key}" itself.
#   path-style:   https://firsts3.ru/now.done
#   domain-style: https://now.done.firsts3.ru
#   website:      https://now.done.web.firsts3.ru
S3_ACCESS_KEY_ID=DM32JH5CY48AFEUQH1P1
S3_SECRET_ACCESS_KEY=TaT0X9BxnxWqKQY2fMtNoiLWMPxWrdSwVGgpn63J
S3_BUCKET_NAME=now.done
S3_ENDPOINT=https://firsts3.ru:443
S3_REGION=default
# Optional. Base URL used to build public links returned to the frontend.
# Empty => "{S3_ENDPOINT}/{S3_BUCKET_NAME}" (path-style), which is the only host
# that currently resolves. now.done.firsts3.ru / now.done.web.firsts3.ru do not
# resolve, so do NOT point this at them.
S3_PUBLIC_BASE_URL=
# Lifetime (minutes) of presigned upload URLs handed to the browser for direct
# S3 uploads. Short by design; default 15 if unset.
S3_PRESIGN_EXPIRY=15

# --- Site -------------------------------------------------------------------
# Public URL of the deployed frontend, used for CORS and building bot deep links.
SITE_URL=https://nowdone.ru
# Set to the frontend's origin to scope the session cookie; leave empty for host-only.
COOKIE_DOMAIN=nowdone.ru

# Base URL the frontend uses to reach the API (e.g. reverse-proxied path or full origin).
VITE_API_BASE_URL=/api

ENV=production
