# --- PostgreSQL (используем локальный PostgreSQL в контейнере)-------------------------------------------------------------
# Пароль должен совпадать с ролью postgres в уже созданном томе postgres_data
# (том инициализирован из .env, POSTGRES_PASSWORD на существующий том не применяется).
# База mydaily создана отдельно и уже мигрирована.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=asdqq134552gg
POSTGRES_DB=mydaily

# Full DSN used by the Go backend (pgx). Host "postgres" matches the Compose
# service name; keep in sync with the POSTGRES_* values above.
DB_DSN=postgres://postgres:asdqq134552gg@postgres:5432/mydaily?sslmode=disable

# --- Auth ---------------------------------------------------------------
# Long random string used to sign JWTs. Generate with: openssl rand -hex 32
JWT_SECRET=CFCC0C2EB7EC82A51AAD36921GHJE4FF2291933A80E139F04F6C528564018CB65CE2

# --- Telegram (локальный запуск = тестовый бот @nowdonetest_bot) -------------------------------------------------------------
# Token from @BotFather. Long polling: этот токен не должен одновременно
# использоваться другим запущенным экземпляром бота.
TELEGRAM_BOT_TOKEN=8855896838:AAHLzxtaAhxClRO7ZizjdZnQpvKUBtZjngg
# Bot username WITHOUT the @, used to build https://t.me/<BOT_USERNAME>?start=... links.
BOT_USERNAME=nowdonetest_bot

# --- OpenAI -----------------------------------------------------------------
# Used by the bot for gpt-4o-mini intent parsing and Whisper voice transcription.
OPENAI_API_KEY=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

# --- S3-compatible object storage (attachments) (тот же бакет firsts3.ru) ------------------------------
# path-style addressing => S3_ENDPOINT это голый корень сервиса, без бакета.
#   path-style:   https://firsts3.ru/now.done
#   domain-style: https://now.done.firsts3.ru
#   website:      https://now.done.web.firsts3.ru
S3_ACCESS_KEY_ID=DM32JH5CY48AFEUQH1P1
S3_SECRET_ACCESS_KEY=TaT0X9BxnxWqKQY2fMtNoiLWMPxWrdSwVGgpn63J
S3_BUCKET_NAME=now.done
S3_ENDPOINT=https://firsts3.ru:443
S3_REGION=default
# Публичный базовый URL для ссылок на вложения (пусто => "{S3_ENDPOINT}/{bucket}").
# now.done.firsts3.ru / now.done.web.firsts3.ru не резолвятся — сюда их не ставить.
S3_PUBLIC_BASE_URL=
# Время жизни (в минутах) presigned-ссылок для прямой загрузки в S3. По умолчанию 15.
S3_PRESIGN_EXPIRY=15

# --- Site -------------------------------------------------------------------
# Public URL of the deployed frontend, used for CORS and building bot deep links.
# Без :80 — браузер шлёт Origin без стандартного порта, иначе CORS не сойдётся.
SITE_URL=http://localhost:8080
# Host-only cookie для локалки: Domain=localhost часть браузеров не принимает.
COOKIE_DOMAIN=

# Base URL the frontend uses to reach the API (e.g. reverse-proxied path or full origin).
VITE_API_BASE_URL=/api

ENV=test
